index ccd13b1..102ea50 100644
--- a/diskjoin_repro_pack/workspace/gate5ar/scripts/run_linux.sh
+++ b/diskjoin_repro_pack/workspace/gate5ar/scripts/run_linux.sh
@@ -14,6 +14,10 @@ export PYTHONDONTWRITEBYTECODE=1
 export OMP_NUM_THREADS=1
 export ASAN_OPTIONS=detect_leaks=1:halt_on_error=1
 export UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1
+# Scratch dir required by tests/*.py (tempfile.TemporaryDirectory(dir=ROOT/"build")).
+# A fresh checkout lacks it because workspace/**/build/ is gitignored; without it the
+# first `units` step aborts with FileNotFoundError. Same action as run_local.sh line 5.
+mkdir -p "$ROOT/build"
 # Prior shell instrumentation/ablation settings must not leak into this run.
 while IFS='=' read -r name value; do
   case "$name" in GATE3_*|GATE4A_*|GATE4B0_*|GATE4B1_*) unset "$name";; esac

