+    // [GATE5B] Read exactly `len` bytes from `fd`, retrying on EINTR and
+    // failing fast on EOF, a short read, or any other error. It never returns
+    // with the destination partially or stale-filled. Public+static so the
+    // read-failure/short-read/EINTR behaviour is unit-testable directly.
+    static void readExactOrThrow(int fd, char* dst, size_t len) {
+        size_t got = 0;
+        while (got < len) {
+            ssize_t r = ::read(fd, dst + got, len - got);
+            if (r < 0) {
+                if (errno == EINTR) continue;
+                throw std::runtime_error(std::string("ClusterIO: read failed: ") + std::strerror(errno));
+            }
+            if (r == 0)
+                throw std::runtime_error("ClusterIO: unexpected EOF (cluster file truncated)");
+            got += (size_t)r;
+        }
+    }
