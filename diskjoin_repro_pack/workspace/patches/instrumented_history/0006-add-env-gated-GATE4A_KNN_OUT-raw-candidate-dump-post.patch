From 0a82b10e737fb0744e9e3ab676cecf552981a3e9 Mon Sep 17 00:00:00 2001
From: gate4a-repro <gate4a@local>
Date: Mon, 2 Nov 2026 15:50:15 +0800
Subject: [PATCH 06/11] add env-gated GATE4A_KNN_OUT raw candidate dump
 (post-knn, pre-pruning; print-only, omp-critical)

---
 lib/DiskJoin.h | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/lib/DiskJoin.h b/lib/DiskJoin.h
index dd11256..44a8587 100644
--- a/lib/DiskJoin.h
+++ b/lib/DiskJoin.h
@@ -56,6 +56,16 @@ struct DiskJoin {
                 top_candidates.pop();
                 dis_to_boundary.emplace_back(temp, neighbor_cluster);
             }
+            // [GATE4A] env-gated raw candidate dump (post-knn, pre-pruning).
+            if (getenv("GATE4A_KNN_OUT")) {
+                #pragma omp critical
+                {
+                    std::ofstream g4a_knn(getenv("GATE4A_KNN_OUT"), std::ios::app);
+                    g4a_knn << i << " " << dis_to_boundary.size();
+                    for (auto& c : dis_to_boundary) g4a_knn << " " << c.first << " " << c.second;
+                    g4a_knn << "\n";
+                }
+            }
             std::sort(dis_to_boundary.begin(), dis_to_boundary.end());
             int ptr = dis_to_boundary.size() - 1;
             float sum_of_angle = 0;
-- 
