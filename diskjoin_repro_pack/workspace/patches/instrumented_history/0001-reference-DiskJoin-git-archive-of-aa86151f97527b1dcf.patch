+    template<typename T>
+    static T L2SqrNaive(const void *pVec1v, const void *pVec2v, const void *dim_ptr) {
+        T *pVec1 = (T*) pVec1v;
+        T *pVec2 = (T*) pVec2v;
+        std::size_t dim = *((std::size_t *) dim_ptr);
+
+        T diff, res=0;
+#pragma omp simd
+        for (auto idx=0; idx<dim; ++idx) {
+            diff = pVec1[idx] - pVec2[idx];
+            res += diff * diff;
+        }
+        return res;
+    }
+
+    template<typename T>
