+        II = np.zeros(nres.sum(), dtype='int32')
+
+        s = 0
+        for i, l in enumerate(nres):
+            DD[s : s + l] = D[i, 0 : l]
+            II[s : s + l] = I[i, 0 : l]
+            s += l
+
+        with open(os.path.join(self.basedir, self.gt_fn), "wb") as f:
+            np.array([self.nq, nres.sum()], dtype='uint32').tofile(f)
