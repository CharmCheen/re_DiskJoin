+                    gate3_total++;
+                }
+            }
+            gate3_f.close();
+            std::cerr << "[gate3] pair_dump=" << gate3_pair_out
+                      << " pairs=" << gate3_total
+                      << " threads=" << gate3_pair_bufs.size() << "\n";
+        }
     }
 };
