+    // Hints must not read beyond logical adjacency or construct invalid pointers.
+    // Invalid *consumed* neighbors fail closed; speculative lookahead is skipped.
+    inline size_t checkedDegree(linklistsizeint* links, size_t capacity,
+                                VisitedList* vl = nullptr) const {
+        size_t count = getListCount(links);
+        if (count > capacity) {
+            if (vl) visited_list_pool_->releaseVisitedList(vl);
+            throw std::runtime_error("gate5ar: invalid HNSW degree");
+        }
+        return count;
+    }
+
+    inline tableint checkedNeighbor(const tableint* ids, size_t count, size_t index,
+                                    VisitedList* vl = nullptr) const {
+        if (index >= count || ids[index] >= cur_element_count) {
+            if (vl) visited_list_pool_->releaseVisitedList(vl);
+            throw std::runtime_error("gate5ar: invalid HNSW neighbor");
+        }
+        return ids[index];
+    }
+
+    inline void prefetchNode(tableint id, const vl_type* visited = nullptr) const {
+        if (id >= cur_element_count) return;
+#if defined(USE_SSE) && !defined(GATE5AR_DISABLE_PREFETCH)
+        _mm_prefetch(getDataByInternalId(id), _MM_HINT_T0);
+        if (visited) {
+            _mm_prefetch(reinterpret_cast<const char*>(visited + id), _MM_HINT_T0);
+            if (max_elements_ - id > 64)
+                _mm_prefetch(reinterpret_cast<const char*>(visited + id + 64), _MM_HINT_T0);
+        }
+#else
+        (void)visited;
+#endif
+    }
+
+    inline void prefetchNeighbor(const tableint* ids, size_t count, size_t index,
+                                 const vl_type* visited = nullptr) const {
+        if (index < count) prefetchNode(ids[index], visited);
+    }
